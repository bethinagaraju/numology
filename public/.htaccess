<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Ensure HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other URLs to index.html for React Router SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Proper MIME types
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# Cache headers
<IfModule mod_headers.c>
  # Never cache index.html so users always get new asset hashes
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </Files>

  # Cache hashed static assets for 1 year
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
